                <div class="d-flex flex-wrap gap-3 mb-5">
                    <a href="#" class="btn btn-primary btn-lg">
                        <i class="fab fa-google-play me-2"></i> GET IT ON Google Play
                    </a>
                    <a href="#" class="btn btn-outline-primary btn-lg">
                        <i class="fab fa-app-store me-2"></i> Available on App Store
                    </a>
                </div>
                <div class="hero-stats">
                    <div class="row text-center">
                        <div class="col-md-4 stat-item">
                            <div class="stat-number">4.9/5</div>
                            <div class="stat-label">User Rating</div>
                        </div>
                        <div class="col-md-4 stat-item">
                            <div class="stat-number">18K+</div>
                            <div class="stat-label">Active Shops</div>
                        </div>
                        <div class="col-md-4 stat-item">
                            <div class="stat-number">৳42Cr+</div>
                            <div class="stat-label">Monthly Transactions</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="position-relative mt-5 mt-lg-0">
                    <img src="https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&q=80&w=1600"
                         class="img-fluid rounded-4 shadow-lg"
                         alt="VendorX Dashboard">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FEATURES -->
<section id="features" class="py-5">
    <div class="container">
        <div class="section-header">
            <span class="section-subtitle">POWERFUL FEATURES</span>
            <h2 class="section-title">Everything Your Shop Needs in One Platform</h2>
            <p class="section-description">Designed specifically for Bangladeshi retailers with local needs in mind</p>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
